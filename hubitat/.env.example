# Fake QA is the default and needs none of these values.
HUBITAT_QA_SOURCE=fake

# For explicit live QA only. Keep the URL at the Maker API instance root.
HUBITAT_MAKER_BASE_URL=http://HUB_IP/apps/api/APP_ID
HUBITAT_MAKER_ACCESS_TOKEN=replace-with-maker-api-token
HUBITAT_DEVICE_IDS=101,102,103

# Set for a refreshed live run. A run still performs at most one upstream request.
HUBITAT_QA_REFRESH_LIVE=0
